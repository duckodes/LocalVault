{
  "manifest_version": 3,
  "name": "密碼庫 - 本機自動填入",
  "version": "1.0.0",
  "description": "透過本機密碼庫，依目前網站網域提供使用者確認後的登入資料填入。",
  "browser_specific_settings": {
    "gecko": {
      "id": "password-vault@localvault.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "使用密碼庫填入",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
